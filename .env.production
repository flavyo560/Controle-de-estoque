# Production Environment Configuration
# IMPORTANT: Never commit this file with real credentials!

# Application
APP_NAME=DEKIDS
APP_VERSION=2.0.0
ENVIRONMENT=production
DEBUG=false

# Database (Supabase PostgreSQL)
# Get from Supabase project settings
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].supabase.co:5432/postgres
DB_POOL_MIN=10
DB_POOL_MAX=20
DB_TIMEOUT=60.0

# Security
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE-THIS-TO-RANDOM-32-CHAR-STRING
ENCRYPTION_KEY=CHANGE-THIS-TO-RANDOM-32-CHAR-STRING
SESSION_DURATION_HOURS=8
PASSWORD_MIN_LENGTH=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30

# Cache
# Use Redis in production for better performance
CACHE_BACKEND=redis
REDIS_HOST=your-redis-host.com
REDIS_PORT=6379
CACHE_DEFAULT_TTL=300

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/dekids.log
LOG_ROTATION=daily
LOG_RETENTION_DAYS=90

# Performance
QUERY_SLOW_THRESHOLD_MS=500
ASYNC_THRESHOLD_MS=50
MAX_CONCURRENT_OPS=10

# File Upload
MAX_UPLOAD_SIZE_MB=10
ALLOWED_FILE_EXTENSIONS=csv,pdf,jpg,png
