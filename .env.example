# .env.example
# Copy this file to .env and fill in the values

# Environment (development, testing, staging, production)
ENVIRONMENT=development

# Application
APP_NAME=DEKIDS
APP_VERSION=2.0.0
DEBUG=false

# Database (Required)
# Example: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/dekids

# Database Connection Pool
DB_POOL_MIN=10
DB_POOL_MAX=20
DB_TIMEOUT=60.0

# Security (Required - Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
SECRET_KEY=your-secret-key-here-min-32-chars
ENCRYPTION_KEY=your-encryption-key-here-min-32-chars

# Session Configuration
SESSION_DURATION_HOURS=8
PASSWORD_MIN_LENGTH=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30

# Cache
CACHE_BACKEND=memory  # or redis
REDIS_HOST=localhost
REDIS_PORT=6379
CACHE_DEFAULT_TTL=300

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/dekids.log
LOG_ROTATION=daily
LOG_RETENTION_DAYS=90

# Performance
QUERY_SLOW_THRESHOLD_MS=1000
ASYNC_THRESHOLD_MS=100
MAX_CONCURRENT_OPS=5

# File Upload
MAX_UPLOAD_SIZE_MB=10
ALLOWED_FILE_EXTENSIONS=csv,pdf,jpg,png
