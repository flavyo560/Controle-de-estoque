# Staging Environment Configuration
# For testing before production deployment

# Application
APP_NAME=DEKIDS-STAGING
APP_VERSION=2.0.0
ENVIRONMENT=staging
DEBUG=false

# Database (Supabase PostgreSQL - Staging)
DATABASE_URL=postgresql://postgres:[STAGING-PASSWORD]@[STAGING-PROJECT-REF].supabase.co:5432/postgres
DB_POOL_MIN=5
DB_POOL_MAX=15
DB_TIMEOUT=60.0

# Security
SECRET_KEY=staging-secret-key-min-32-characters
ENCRYPTION_KEY=staging-encryption-key-min-32-chars
SESSION_DURATION_HOURS=8
PASSWORD_MIN_LENGTH=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30

# Cache
CACHE_BACKEND=memory
REDIS_HOST=localhost
REDIS_PORT=6379
CACHE_DEFAULT_TTL=300

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/dekids_staging.log
LOG_ROTATION=daily
LOG_RETENTION_DAYS=60

# Performance
QUERY_SLOW_THRESHOLD_MS=1000
ASYNC_THRESHOLD_MS=100
MAX_CONCURRENT_OPS=5

# File Upload
MAX_UPLOAD_SIZE_MB=10
ALLOWED_FILE_EXTENSIONS=csv,pdf,jpg,png
