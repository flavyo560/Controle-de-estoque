# Development Environment Configuration
# Copy this file to .env and fill in your values

# Application
APP_NAME=DEKIDS
APP_VERSION=2.0.0
ENVIRONMENT=development
DEBUG=true

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/database
DB_POOL_MIN=5
DB_POOL_MAX=10
DB_TIMEOUT=60.0

# Security
SECRET_KEY=your-secret-key-min-32-characters-long-here
ENCRYPTION_KEY=your-encryption-key-min-32-characters-long
SESSION_DURATION_HOURS=8
PASSWORD_MIN_LENGTH=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30

# Cache
CACHE_BACKEND=memory
REDIS_HOST=localhost
REDIS_PORT=6379
CACHE_DEFAULT_TTL=300

# Logging
LOG_LEVEL=DEBUG
LOG_FILE=logs/dekids.log
LOG_ROTATION=daily
LOG_RETENTION_DAYS=30

# Performance
QUERY_SLOW_THRESHOLD_MS=1000
ASYNC_THRESHOLD_MS=100
MAX_CONCURRENT_OPS=5

# File Upload
MAX_UPLOAD_SIZE_MB=10
ALLOWED_FILE_EXTENSIONS=csv,pdf,jpg,png

# Testing
TEST_DATABASE_URL=postgresql://test:test@localhost/test_dekids
